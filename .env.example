# Copy to .env and adjust. These values are what the API container uses, so services
# are addressed by their compose service name (postgres, opensearch, ollama, redis).

# ── Core services ───────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://arxiv:arxiv@postgres:5432/arxiv
REDIS_URL=redis://redis:6379/0
OPENSEARCH__HOST=http://opensearch:9200
OPENSEARCH__INDEX=arxiv-papers
OLLAMA__HOST=http://ollama:11434
OLLAMA__MODEL=llama3.2:3b

# ── Required from Stage 4 onward (free tier: https://jina.ai) ────────
JINA_API_KEY=

# ── Optional: Stage 6 observability (self-hosted Langfuse) ──────────
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=

# ── Optional: Stage 7 Telegram bot (token from @BotFather) ──────────
TELEGRAM__BOT_TOKEN=
